; Engine configuration file.
config_version=5

[application]

config/name="Iron Crowns: Grand Strategy (Vertical Slice)"
config/description="Real-time grand strategy with a 3D campaign map and simulated 3D battles."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameData="*res://scripts/core/game_data.gd"
Sim="*res://scripts/core/sim.gd"
Controls="*res://scripts/core/controls.gd"
Audio="*res://scripts/audio/audio_manager.gd"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)

[filesystem]

import/blender/enabled=false
